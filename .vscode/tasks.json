{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Iniciar controle remoto TCL",
			"type": "shell",
			"command": "node",
			"args": [
				"server.js"
			],
			"options": {
				"env": {
					"REMOTE_UI_ORIGINS": "${input:githubPagesOrigin}"
				}
			},
			"isBackground": true,
			"problemMatcher": {
				"owner": "custom",
				"pattern": {
					"regexp": "^$",
					"message": 0
				},
				"background": {
					"activeOnStart": true,
					"beginsPattern": "Iniciando backend do controle remoto",
					"endsPattern": "Servidor a correr na porta 3000"
				}
			}
		}
	],
	"inputs": [
		{
			"id": "githubPagesOrigin",
			"type": "promptString",
			"description": "Origem do GitHub Pages autorizada a controlar a TV (ex.: https://usuario.github.io). Deixe vazio se ainda nao publicou.",
			"default": "https://operacaoindustria-boop.github.io"
		}
	]
}